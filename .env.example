# Comma-separated list of origins allowed to call this API.
# Set to your deployed frontend's URL(s) in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Never enable in production - exposes an interactive debugger on errors.
DEBUG=false

# Render (and most PaaS hosts) inject PORT automatically; only needed for
# local runs via `python -m backend`.
PORT=6050
HOST=127.0.0.1
